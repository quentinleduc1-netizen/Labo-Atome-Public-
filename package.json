{
  "name": "labo-atomes",
  "version": "1.18.0",
  "description": "Entraînement au chapitre I de sciences des matériaux : atomes, ions, quantité de matière, configurations électroniques",
  "main": "main.js",
  "author": "Quentin Leduc",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fr.quentinleduc.laboatomes",
    "productName": "Labo Atomes",
    "publish": null,
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LaboAtomes-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LaboAtomes-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "artifactName": "LaboAtomes-${version}-mac.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "artifactName": "LaboAtomes-${version}.${ext}"
    }
  }
}
